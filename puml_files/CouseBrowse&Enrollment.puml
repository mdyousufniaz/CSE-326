@startuml 4
title Course Browse and Enrollment \n\n

!include rules.puml

class CourseListUI <<view>> {
    EMPTY_LINE
    
    +displayAllCourses(courses: List<Course>) : void
    +showSearchResults(courses: List<Course>) : void
    +searchCourse(query: String) : void
    +selectCourse(courseId: int) : void
}

class CourseDetailsUI <<view>> {
    EMPTY_LINE
    
    +showCourseDetails(course: Course) : void
    +showSyllabus(sections: List<Section>) : void
    +showReviews(reviews: List<Review>) : void
    +enrollCourse() : void
    +processPayment() : void
}

class EnrolledCoursesUI <<view>> {
    EMPTY_LINE
    
    +showEnrolledCourses(courses: List<Course>) : void
    +resumeCourse(courseId: int) : void
}

class CourseControl <<control>> {
    EMPTY_LINE
    
    +retrieveAllCourses() : List<Course>
    +retrieveCourseDetails(courseId: int) : Course
    +searchCourses(query: String) : List<Course>
    +processEnrollment(studentId: int, courseId: int) : boolean
    +processPayment(paymentData: Map<String, Object>) : boolean
    +getEnrolledCourses(studentId: int) : List<Course>
}

class Course <<model>> {
    -courseId : int
    -title : String
    -description : String
    -instructorId : int
    -price : double
    -isFree : boolean
    -thumbnailId : int
    -createdDate : String
    -isPublished : boolean
    +getCourseInfo() : Map<String, Object>
    +publishCourse() : void
}

class Enrollment <<model>> {
    -enrollmentId : int
    -studentId : int
    -courseId : int
    -enrollmentDate : String
    +createEnrollment(data: Map<String, Object>) : boolean
}

class Payment <<model>> {
    -paymentId : int
    -amount : double
    -studentId : int
    -courseId : int
    --
    EMPTY_LINE
}

' Relationships based on the arrows in the image
CourseListUI --> CourseControl
CourseDetailsUI --> CourseControl
EnrolledCoursesUI --> CourseControl

CourseControl --> Course
CourseControl --> Enrollment
CourseControl --> Payment

@enduml